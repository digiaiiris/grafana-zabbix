# syntax=docker/dockerfile:1
# Dockerfile for building grafana-zabbix artifacts

# Backend (golang) build
FROM golang:1.19.13 AS go-builder

COPY / /build

WORKDIR /build

RUN go install -v ./pkg/ && \
    make dist-backend

# Frontend (node) build and packaging
FROM node:16-alpine3.15 AS js-builder

ARG GRAFANA_ROOT_URLS

COPY / /build

WORKDIR /build

RUN yarn install --pure-lockfile && \
    yarn build && \
    rm -rf node_modules && \
    rm -rf ~/.npm

COPY --from=go-builder /build/dist/ /build/dist

# Token is mounted as a BuildKit secret so it is not persisted in image layers/history
RUN --mount=type=secret,id=grafana_token,env=GRAFANA_ACCESS_POLICY_TOKEN,required=true \
    npx @grafana/sign-plugin@1.1.0 --rootUrls $GRAFANA_ROOT_URLS

RUN cd dist && \
    tar czvf ../iiris-zabbix-plugin.tar.gz *
