#!/bin/bash
set -euo pipefail

# Parse options
if ! OPTS=$(getopt -o rt: --long release,tar: -n 'parse-options' -- "${@}"); then
  echo "Failed parsing options." >&2
  exit 1
fi

eval set -- "$OPTS"

# Declare variables
TARFILE=
GRAFANA_ACCESS_POLICY_TOKEN=$(gcloud secrets versions access latest --secret=ci-grafana-access-policy-token --project=digia-iiris-dev)
GRAFANA_ROOT_URLS=$(gcloud secrets versions access latest --secret=ci-grafana-plugin-rooturls --project=digia-iiris-dev)

while true; do
  case "$1" in
    -r | --release ) TARFILE="iiris-zabbix-plugin.tar.gz"; shift;;
    -t | --tar ) TARFILE="$2"; shift 2;;
    -- ) shift; break ;;
    * ) break ;;
  esac
done

if [ -z "${GRAFANA_ACCESS_POLICY_TOKEN}" ]; then
  echo "ERROR: Grafana Access Policy token is missing. Fetching GCP secret 'ci-grafana-access-policy-token' (project digia-iiris-dev) returned an empty value!" >&2
  exit 1
fi

if [ -z "${GRAFANA_ROOT_URLS}" ]; then
  echo "ERROR: Grafana root URLs missing. Fetching GCP secret 'ci-grafana-plugin-rooturls' (project digia-iiris-dev) returned an empty value!" >&2
  exit 1
fi

# The build is done inside a Docker container so that the distribution matches Grafana's
# distribution. If the build was done in the host instead, the distro would be different and the
# binaries would not work.
export GRAFANA_ACCESS_POLICY_TOKEN
docker build --network=host . -f Dockerfile.iiris-build -t iiris-zabbix-plugin-build --secret id=grafana_token,env=GRAFANA_ACCESS_POLICY_TOKEN --build-arg=GRAFANA_ROOT_URLS="${GRAFANA_ROOT_URLS}"

# Extract the built tarball from the Docker container if a TARFILE is specified.
if [ ! -z "$TARFILE" ]; then
  docker run --rm -i --entrypoint sh iiris-zabbix-plugin-build -c "cat iiris-zabbix-plugin.tar.gz" >"${TARFILE}"
fi
